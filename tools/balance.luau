--!nocheck
-- tools/balance.luau — crafting balance report (tests/lib/balance.luau).
--
--   lune run tools/balance.luau                 # every biome, 2 seeds (~5 min)
--   lune run tools/balance.luau FOREST 1        # one biome, 1 seed (quick)
--
-- Writes reports/balance/summary.md and reports/balance/<biome>.json, and
-- exits 1 when a Constants.BALANCE_TARGETS check fails.

local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")

local World = require("../tests/lib/world")
local Balance = require("../tests/lib/balance")

local only = process.args[1]
local seeds = tonumber(process.args[2]) or 2
local matches = tonumber(process.args[3]) or 3000
local biomes = { "FOREST", "OCEAN", "SKY" }
if only and only ~= "all" then biomes = { only:upper() } end

fs.writeDir("reports/balance")
local lines = {}
local function line(s) table.insert(lines, s or "") end
local failed = 0

line("# Crafting balance")
line()
line("Generated by `lune run tools/balance.luau` (model: `tests/lib/balance.luau`, targets: `Constants.BALANCE_TARGETS`).")
line()
line("**Value** = seconds an item saves its owner per race, on average over every partner build: its stats (pace fitted to KineSim races) + its E ability (fired by a sensible player in a KineSim race; a harmful one = hits per race × the seconds one hit costs the rival) + protection (shield / lift uptime × the hits a racer takes). **Matches**: Monte Carlo fields of 6 players with farmed inventories (spawn odds `RARITY_SPAWN_DIST`), each crafting the core items worth most; race time = pace − own gains + hits taken + driver noise (σ " .. Balance.NOISE .. " s).")
line()

for _, biome in ipairs(biomes) do
	local t0 = os.clock()
	local world = World.build(biome, { visibility = "intended" })
	local env = world.env
	local Constants = env.requirePath("ReplicatedStorage.Shared.Constants")
	local ItemConfig = env.requirePath("ReplicatedStorage.Shared.ItemConfig")
	local B = Balance.measure(world, { seeds = seeds })
	local m = Balance.matches(B, { matches = matches, seed = 7 }, Constants, ItemConfig)
	local checks = Balance.check(B, m, Constants.BALANCE_TARGETS)

	line("## " .. biome)
	line()
	line(string.format("Median car %s: %.1f s (%s driver, %d seeds, %d sim races, %.0f s). Pace fit R² %.2f; s per stud/s top speed %.2f, per rad/s turn %.2f.",
		B.baseBuild, B.baseTime, B.driver, B.seeds, B.runs, os.clock() - t0, B.pace.r2, B.pace.coef[2], B.pace.coef[3]))
	line()
	line("| | Check | Value | Target | Why |")
	line("|---|---|---|---|---|")
	for _, c in ipairs(checks) do
		if not c.ok then failed += 1 end
		line(string.format("| %s | %s | %s | %s | %s |", c.ok and "✓" or "✗", c.name, c.value, c.target, c.why))
	end
	line()
	line(string.format("Matches: %d, distinct winning cores %d, most common %s (%.0f%%), mean winning margin %.1f s.",
		m.matches, m.distinctCores, tostring(m.topCore), m.topCoreShare * 100, m.avgMargin))
	line()
	line("| Slot | Item | Rarity | Ability kind | Value | Stats | Own gain | Offense | Protect | Uses | Win lift |")
	line("|---|---|---|---|---|---|---|---|---|---|---|")
	local list = {}
	for _, it in pairs(B.items) do table.insert(list, it) end
	table.sort(list, function(a, b)
		if a.slot ~= b.slot then return a.slot < b.slot end
		if a.rarity ~= b.rarity then return Balance.RANK[a.rarity] < Balance.RANK[b.rarity] end
		return a.value > b.value
	end)
	for _, it in ipairs(list) do
		line(string.format("| %s | %s | %s | %s | **%.1f** | %.1f | %.1f | %.1f | %.1f | %.1f | %s |",
			it.slot, it.name, it.rarity, it.kind, it.value, it.statGain, it.selfGain, it.offense, it.block, it.uses,
			m.lift[it.name] and string.format("%.2f", m.lift[it.name]) or "-"))
	end
	line()
	line("Win lift = share of winning builds / share of all builds that equip the item (1 = average).")
	line()

	local json = { biome = biome, baseTime = B.baseTime, pace = { r2 = B.pace.r2, coef = B.pace.coef, samples = B.pace.samples },
		items = B.items, victimCost = B.victimCost, incoming = B.incoming, checks = checks,
		matches = { distinctCores = m.distinctCores, topCore = m.topCore, topCoreShare = m.topCoreShare,
			topItemShare = m.topItemShare, upsetRate = m.upsetRate, lift = m.lift, wins = m.wins, winsBySlot = m.winsBySlot } }
	fs.writeFile("reports/balance/" .. biome:lower() .. ".json", serde.encode("json", json, true))
	print(string.format("%s done in %.0f s, %d checks failed so far", biome, os.clock() - t0, failed))
end

fs.writeFile("reports/balance/summary.md", table.concat(lines, "\n"))
print(table.concat(lines, "\n"))
if failed > 0 then process.exit(1) end
